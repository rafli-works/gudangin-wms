{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/livewire/livewire.js(.*)",
      "dest": "/public/livewire/livewire.js"
    },
    {
      "src": "/livewire/livewire.min.js(.*)",
      "dest": "/public/livewire/livewire.min.js"
    },
    {
      "src": "/livewire/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/favicon.png",
      "dest": "/public/favicon.png"
    },
    {
      "src": "/(.*)\\.(css|js|jpg|jpeg|png|svg|ico|woff|woff2|ttf)",
      "dest": "/public/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://gudangin-wms-sdt.vercel.app",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr",
    "APP_STORAGE": "/tmp/storage",
    "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
    "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php"
  }
}
